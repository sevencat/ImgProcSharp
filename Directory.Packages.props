<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- 主库只依赖契约层；格式解码器/编码器由上层按需引用（misc §B / §Q / §AB） -->
    <PackageVersion Include="Sdcb.SimdCodecs.Abstractions" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdCodecs.Png" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdCodecs.Jpeg" Version="2.0.0" />

    <PackageVersion Include="BenchmarkDotNet" Version="0.15.2" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
